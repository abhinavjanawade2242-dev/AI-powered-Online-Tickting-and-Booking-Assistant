{
  "info": {
    "_postman_id": "ps07-ticketing-booking-assistant-v1",
    "name": "PS-07: AI-Powered Online Ticketing & Booking Assistant",
    "description": "Comprehensive API collection for PS-07 QA testing, integration verification, and demo execution.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "host",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "booking_ref",
      "value": "BK-TECH01",
      "type": "string"
    },
    {
      "key": "ticket_code",
      "value": "TIX-9A82B3C4",
      "type": "string"
    },
    {
      "key": "lock_token",
      "value": "LCK-SAMPLE-TOKEN",
      "type": "string"
    },
    {
      "key": "session_id",
      "value": "sess_test123",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System & Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host}}/health",
              "host": [
                "{{host}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "System Root Metadata",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/",
              "host": [
                "{{host}}"
              ],
              "path": [
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Discovery & Catalogue (US-01 to US-04)",
      "item": [
        {
          "name": "List All Venues",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/venues",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "venues"
              ]
            }
          }
        },
        {
          "name": "List Active Events",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/events?limit=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "events"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Search Events by Keyword",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/events?search=Technovate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "events"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Technovate"
                }
              ]
            }
          }
        },
        {
          "name": "Filter Events by Category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/events?category=Technical",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "events"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "Technical"
                }
              ]
            }
          }
        },
        {
          "name": "Filter Events by Venue",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/events?venue_id=venue-tech-hub",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "events"
              ],
              "query": [
                {
                  "key": "venue_id",
                  "value": "venue-tech-hub"
                }
              ]
            }
          }
        },
        {
          "name": "Get Event Details",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/events/event-technovate-hack",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "events",
                "event-technovate-hack"
              ]
            }
          }
        },
        {
          "name": "Check Real-Time Availability & INR Pricing",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/events/event-technovate-hack/availability",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "events",
                "event-technovate-hack",
                "availability"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Booking & Concurrency Lock (US-05 to US-08)",
      "item": [
        {
          "name": "Hold / Lock Inventory (Redis Lock)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "idemp-lock-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tier_id\": \"tier-tech-early\",\n  \"quantity\": 2,\n  \"customer_id\": \"cust-001\",\n  \"customer_name\": \"Manohar QA\",\n  \"customer_email\": \"manohar.qa@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/bookings/lock",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bookings",
                "lock"
              ]
            }
          }
        },
        {
          "name": "Confirm Booking from Active Lock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "idemp-bk-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"booking_ref\": \"{{booking_ref}}\",\n  \"payment_method\": \"SIMULATED_UPI\",\n  \"simulated_status\": \"SUCCESS\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/bookings/confirm",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bookings",
                "confirm"
              ]
            }
          }
        },
        {
          "name": "Retrieve Booking Details",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/bookings/{{booking_ref}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bookings",
                "{{booking_ref}}"
              ]
            }
          }
        }
      ]
    },
    {
