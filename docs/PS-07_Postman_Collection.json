                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"simulated_outcome\": \"PENDING\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/bookings/{{booking_ref}}/payment-simulation",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bookings",
                "{{booking_ref}}",
                "payment-simulation"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Digital Tickets & Gate Verification (US-08)",
      "item": [
        {
          "name": "Get Ticket Info",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/tickets/{{ticket_code}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tickets",
                "{{ticket_code}}"
              ]
            }
          }
        },
        {
          "name": "Get Base64 QR Code Image",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/tickets/{{ticket_code}}/qr",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tickets",
                "{{ticket_code}}",
                "qr"
              ]
            }
          }
        },
        {
          "name": "Gate Scanner Verification (HMAC Signed)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qr_payload\": \"TIX-SAMPLE|BK-REF|event-id|Early Bird|1730000000|abc123456789\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/tickets/verify",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tickets",
                "verify"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "6. Cancellation & Refunds (US-15 to US-16)",
      "item": [
        {
          "name": "Cancel Booking (Restores Inventory)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Student schedule change\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/bookings/{{booking_ref}}/cancel",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bookings",
                "{{booking_ref}}",
                "cancel"
              ]
            }
          }
        }
      ]
    },
