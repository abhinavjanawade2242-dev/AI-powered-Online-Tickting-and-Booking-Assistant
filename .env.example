# ==============================================================================
# AI-Powered Online Ticketing and Booking Assistant - Environment Configuration
# ==============================================================================

PROJECT_NAME="AI Ticketing & Booking Assistant"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL)
# Async driver for FastAPI runtime (asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ticketing_db"
# Sync driver for Alembic migrations (psycopg2)
SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/ticketing_db"

# Redis & Distributed Locking
REDIS_URL="redis://localhost:6379/0"
LOCK_EXPIRY_SECONDS=10
RESERVATION_HOLD_TTL_SECONDS=600

# Celery Task Queue
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# LLM Providers Configuration
# Supported providers: "openai", "gemini", or "mock" (for testing without API keys)
LLM_PROVIDER="gemini"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-pro"

# Authentication & JWT Security
SECRET_KEY="technovate-super-secret-jwt-key-ps07-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Meta WhatsApp Cloud API Integration
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="technovate_whatsapp_verify_token_2026"
WHATSAPP_APP_SECRET=""
WHATSAPP_API_VERSION="v21.0"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

